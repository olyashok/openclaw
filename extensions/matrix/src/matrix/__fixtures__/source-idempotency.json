{
  "version": 1,
  "derivation": "provider:account:msg:room:revision:part:kind:target_event_id. Each field escapes '%' as '%25' and then ':' as '%3A'. An absent field is the empty string. revision and part are decimal integers.",
  "account": "ai.cellect.projection.origin.accountId of the projected copy",
  "targets": {
    "publish": "eventId, the new copy",
    "edit": "replacesEventId, the original the replacement targets (m.relates_to.event_id). eventId is the replacement event",
    "redact": "eventId, the event actually redacted (the m.room.redaction 'redacts'). For the gateway this is ProjectionAction.eventId, not its targetEventId",
    "retire_notice": "eventId, the redacted notice",
    "notice": "eventId, the notice",
    "backfill": "eventId, the retained copy"
  },
  "revisionAndPart": {
    "publish/edit/backfill": "publicationRevision and partIndex written by the action (the edit's m.new_content marker)",
    "redact": "the redacted copy's current publicationRevision (after any in-place edit) and partIndex, as recorded in the mapping; absent when unknown",
    "retire_notice/notice": "absent"
  },
